# Optional local launcher overrides for FinlayCut.
# Copy this file to .env.launcher and uncomment only what you need.

# RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
# RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"
# FINLAYCUT_FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
# FINLAYCUT_FFPROBE_PATH="/opt/homebrew/bin/ffprobe"
# FINLAYCUT_DEBUG_CUT_PLANNING=1
# FINLAYCUT_DEBUG_LOG_LIMIT=20
